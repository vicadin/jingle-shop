mixin timer()
    .timer&attributes(attributes)
        .timer__item
            span.timer__number(data-unit="days") 35
            span.timer__label Days

        .timer__item
            span.timer__number(data-unit="hours") 08
            span.timer__label Hours

        .timer__item
            span.timer__number(data-unit="minutes") 24
            span.timer__label Minutes

        .timer__item
            span.timer__number(data-unit="seconds") 17
            span.timer__label Seconds